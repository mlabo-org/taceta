{
  "manifest_version": 3,
  "name": "Taceta Link",
  "version": "0.1.0",
  "description": "A local browser harness for Taceta-owned tabs.",
  "key": "",
  "permissions": ["debugger", "tabGroups", "storage", "nativeMessaging", "search", "alarms", "scripting", "webNavigation", "tabs"],
  "host_permissions": ["https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Taceta Link", "default_popup": "popup.html" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
